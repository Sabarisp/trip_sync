rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isRoomMember(roomId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
    }

    // Users can read any profile (needed to show member names/avatars in a
    // shared room) but can only write their own.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Anyone signed in can read a room by ID (that's how "join by code"
    // works) and create new rooms. Only existing members can update one
    // (e.g. add themselves via arrayUnion, set a destination) or delete it.
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isRoomMember(roomId) ||
        // allow a joining user to add themselves
        (isSignedIn() &&
         request.resource.data.members.hasAll(resource.data.members) &&
         request.resource.data.members.hasOnly(resource.data.members.concat([request.auth.uid])));
      allow delete: if isRoomMember(roomId);
    }

    // Live locations are scoped to room members only — not public, not
    // readable by other rooms.
    match /locations/{roomId}/members/{memberId} {
      allow read: if isRoomMember(roomId);
      allow write: if isSignedIn() && request.auth.uid == memberId && isRoomMember(roomId);
    }
  }
}
